# Envio do backup para fora da VPS (lido por deploy/backup.sh).
# Na VPS fica em /etc/inbox/backup.env (root:inbox, 640). Nunca versione valores reais.
# Com BACKUP_AGE_RECIPIENT ou BACKUP_REMOTE_PATH vazios, o backup fica só na VPS.

# Chave PÚBLICA do age (começa com age1), gerada no seu computador com age-keygen.
# A chave privada nunca vem para a VPS.
BACKUP_AGE_RECIPIENT=

# Backblaze B2: Application Keys > Add a New Application Key, restrita ao bucket,
# com acesso "Write Only". ACCOUNT = keyID, KEY = applicationKey.
RCLONE_CONFIG_OFFSITE_TYPE=b2
RCLONE_CONFIG_OFFSITE_ACCOUNT=
RCLONE_CONFIG_OFFSITE_KEY=

# Destino no formato offsite:<nome-do-bucket>/db (o prefixo offsite: é obrigatório).
BACKUP_REMOTE_PATH=

# Opcional: URL de ping do healthchecks.io. Recebe um ping quando o backup e o
# envio dão certo e <URL>/fail quando algo falha.
BACKUP_HEARTBEAT_URL=
