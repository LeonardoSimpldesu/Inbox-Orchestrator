# HTTP only: answers the Let's Encrypt challenge before a certificate exists.
server {
    listen 80;
    listen [::]:80;
    server_name __APP_DOMAIN__;
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
