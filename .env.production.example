# Production template: copy to .env on the server and fill in the secrets.
# Never deploy with APP_DEBUG=true (stack traces and env leak on errors).
APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://inbox.example.com

INERTIA_DEVTOOLS_ENABLED=false

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Password reset e-mails depend on a working mailer. Production will use
# Resend (requires `composer require resend/resend-php` when enabled):
# MAIL_MAILER=resend
# RESEND_API_KEY=
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="Inbox Orchestrator"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Gmail OAuth (Google Cloud Console > APIs & Services):
#   1. Enable the Gmail API.
#   2. OAuth consent screen: External, publishing status "Testing", add every
#      person who will connect a Gmail as a test user, scopes gmail.modify and
#      gmail.send.
#   3. Credentials > OAuth client ID > Web application, authorized redirect URI
#      = GOOGLE_REDIRECT_URI.
# While the app is in "Testing", Google expires refresh tokens after 7 days and
# GOOGLE_OAUTH_TESTING=true makes the app show the reconnect deadline.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/accounts/google/callback
GOOGLE_OAUTH_TESTING=true

VITE_APP_NAME="${APP_NAME}"
