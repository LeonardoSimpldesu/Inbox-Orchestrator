# Production template: copy to .env on the server and fill in the secrets.
# Never deploy with APP_DEBUG=true (stack traces and env leak on errors).
APP_NAME="Inbox Orchestrator"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_SCHEDULE_TIMEZONE=America/Sao_Paulo
DISCONNECTED_ACCOUNT_RETENTION_DAYS=90
# provision.sh replaces __APP_DOMAIN__ with the real subdomain on the server.
APP_URL=https://__APP_DOMAIN__

INERTIA_DEVTOOLS_ENABLED=false

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_JOURNAL_MODE=wal
DB_BUSY_TIMEOUT=5000
DB_SYNCHRONOUS=normal
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the longest job (Gmail sync: 1500 s), or a running job is handed out again.
DB_QUEUE_RETRY_AFTER=1600

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Password reset e-mails go through Resend. The sender domain must be verified
# in the Resend dashboard (SPF/DKIM DNS records) before MAIL_FROM_ADDRESS works.
MAIL_MAILER=resend
RESEND_KEY=
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="Inbox Orchestrator"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Gmail OAuth (Google Cloud Console > Google Auth Platform):
#   1. Enable the Gmail API.
#   2. Branding: app name, support e-mail, home page https://<domain>/sobre,
#      privacy policy https://<domain>/privacidade, authorized domain.
#   3. Data access: scopes gmail.modify and gmail.send.
#   4. Clients > Web application, authorized redirect URI = GOOGLE_REDIRECT_URI.
#   5. Audience: External, "Publish app" without submitting for verification
#      (users see the "unverified app" screen; limit of 100 users). Refresh
#      tokens then stop expiring after 7 days. Accounts connected while the app
#      was in "Testing" must reconnect once.
# GOOGLE_OAUTH_TESTING=true only while the app is still in "Testing": it shows
# the 7-day reconnect deadline.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://__APP_DOMAIN__/accounts/google/callback
GOOGLE_OAUTH_TESTING=false
# Gmail API units each account may spend per minute; keep it below the project's
# "Units per minute per user" quota (Cloud Console > Gmail API > Quotas).
GMAIL_QUOTA_UNITS_PER_MINUTE=1200

# Shown on /privacidade (Política de Privacidade). Required by deploy.sh.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=

VITE_APP_NAME="${APP_NAME}"
